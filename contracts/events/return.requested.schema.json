{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://robo.net.br/schemas/v1/events/return.requested.json",
  "title": "ReturnRequestedPayload",
  "description": "Payload emitido quando uma devolução/RMA é solicitada pelo cliente",
  "type": "object",
  "required": [
    "return_id",
    "order_number",
    "items",
    "status",
    "requested_at"
  ],
  "additionalProperties": false,
  "properties": {
    "return_id": { "type": "string", "minLength": 1 },
    "order_number": { "type": "string", "minLength": 1 },
    "customer_id": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "qty", "reason"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": { "type": "string", "enum": ["requested", "approved", "rejected", "received", "refunded"] },
    "notes": { "type": "string" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
