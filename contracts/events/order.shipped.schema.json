{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://robo.net.br/schemas/v1/events/order.shipped.json",
  "title": "OrderShippedPayload",
  "description": "Payload emitido quando o pedido foi despachado para entrega",
  "type": "object",
  "required": [
    "order_id",
    "order_number",
    "carrier",
    "tracking_code",
    "shipped_at"
  ],
  "additionalProperties": false,
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "order_number": { "type": "string", "minLength": 1 },
    "carrier": { "type": "string", "minLength": 1, "description": "ex.: Correios, Jadlog" },
    "tracking_code": { "type": "string", "minLength": 1 },
    "tracking_url": { "type": "string", "format": "uri" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku", "qty"],
        "properties": {
          "sku": { "type": "string" },
          "qty": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "shipped_at": { "type": "string", "format": "date-time" }
  }
}
